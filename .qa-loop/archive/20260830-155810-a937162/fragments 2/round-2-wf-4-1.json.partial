{
  "findings": [
    {
      "id": "bug/WF-4:autofinish-defer-not-persisted",
      "claim": "'Not yet' stops the auto-finish prompt only for the life of the process: the app re-offers 'Ready to finish' the moment the very same game is restored after an app kill/cold relaunch (same deal, same move count, same clock), so the promise that it will not nag again this game is broken by any process restart.",
      "type": "bug",
      "routing": "auto",
      "severity": "minor",
      "confidence": "confirmed",
      "region": "WF-4",
      "test_case": "TC-4.2",
      "build_sha": "369c365",
      "evidence": {
        "screenshots": [
          ".qa-loop/evidence/round-2/wf-4-1/tc42-not-yet-finish-pill.png",
          ".qa-loop/evidence/round-2/wf-4-1/tc42-no-prompt-after-relaunch.png",
          ".qa-loop/evidence/round-2/wf-4-1/tc42-no-renag-after-move-post-relaunch.png"
        ],
        "repro": [
          "inject save69.json (deal #10011, move 69, OLD save format with no autoFinishDeferred key) with causeway.autofinishmode=ask; xcrun simctl launch",
          "tap (224,590) -> 'Ready to finish' alert appears",
          "tap 'Not yet' (128,497) -> alert gone, gold Finish pill, Moves 70",
          "xcrun simctl terminate; read the plist: causeway.game now contains autoFinishDeferred:true",
          "xcrun simctl launch -> same game restores (Deal #10011, Moves 70, Auto-finish: Ask) and NO 'Ready to finish' alert appears",
          "tap (224,590) again (Q-diamond -> down foundation, Moves 71) -> still no prompt"
        ],
        "measurements": {
          "moves_after_relaunch": 70,
          "prompt_reappeared": false,
          "persisted_autoFinishDeferred": true,
          "old_format_save_decoded": true
        }
      },
      "first_seen_round": 1,
      "introduced_by_fix": false,
      "status_history": [
        { "round": 1, "status": "open" },
        { "round": 2, "status": "fixed" }
      ],
      "current_status": "fixed",
      "note": "Verified on 369c365: deferAutoFinish() persists and restore() reads s.autoFinishDeferred ?? false. Old-format saves (no key) still decode and still prompt normally — both TC-4.1 and TC-4.2 launched from pre-fix-shaped JSON. deal() resets the flag, so a New game/Replay still prompts (checked in source and by TC-4.4's fresh injections).",
      "fix_risk": "state-migration"
    }
  ]
}
